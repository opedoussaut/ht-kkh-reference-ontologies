{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opedoussaut.github.io/ht-kkh-reference-ontologies/schema/ontology.schema.json",
  "title": "Engineering Knowledge Atlas — resource record (schema v3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "fullName",
    "summary",
    "publisher",
    "publisherType",
    "kind",
    "layer",
    "topics",
    "version",
    "maturity",
    "license",
    "links",
    "formats",
    "industries",
    "useCases",
    "verification",
    "origin",
    "resourceType",
    "knowledge",
    "capabilities",
    "classificationBasis",
    "physicalAi",
    "limitations",
    "editorialReview"
  ],
  "definitions": {
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "type"
      ],
      "properties": {
        "url": {
          "$ref": "#/definitions/url"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "type": {
          "description": "Evidence type id (data/taxonomy/evidence-types.json)",
          "type": "string"
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "fullName": {
      "type": "string",
      "minLength": 2
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "publisher": {
      "type": "string",
      "minLength": 2
    },
    "publisherType": {
      "enum": [
        "standards-body",
        "industry-association",
        "consortium",
        "research",
        "government",
        "industry"
      ]
    },
    "kind": {
      "enum": [
        "ontology",
        "vocabulary",
        "meta-model",
        "information-model",
        "modeling-language",
        "classification"
      ]
    },
    "layer": {
      "enum": [
        "upper",
        "mid-level",
        "cross-domain",
        "domain"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "standardRef": {
      "type": "string"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "date",
        "status"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 3
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "status": {
          "enum": [
            "published",
            "candidate",
            "draft",
            "superseded",
            "discontinued",
            "unknown"
          ]
        }
      }
    },
    "maturity": {
      "enum": [
        "standard",
        "stable",
        "emerging",
        "research",
        "legacy",
        "discontinued"
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "access",
        "url",
        "reviewStatus",
        "commercialReuse"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "access": {
          "enum": [
            "open",
            "open-with-terms",
            "licensed",
            "unknown"
          ]
        },
        "url": {
          "oneOf": [
            {
              "$ref": "#/definitions/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewStatus": {
          "enum": [
            "not-assessed",
            "reviewed"
          ]
        },
        "commercialReuse": {
          "enum": [
            "unknown",
            "permitted",
            "restricted",
            "not-permitted"
          ]
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official"
      ],
      "properties": {
        "official": {
          "oneOf": [
            {
              "$ref": "#/definitions/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "specification": {
          "$ref": "#/definitions/url"
        },
        "repository": {
          "$ref": "#/definitions/url"
        },
        "namespace": {
          "$ref": "#/definitions/url"
        },
        "related": {
          "$ref": "#/definitions/url"
        },
        "distributions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "format"
            ],
            "properties": {
              "url": {
                "$ref": "#/definitions/url"
              },
              "format": {
                "type": "string"
              },
              "mediaType": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checkedOn",
        "sources",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partially-verified",
            "unverified"
          ]
        },
        "checkedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source"
          },
          "minItems": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "needsReview": {
      "type": "boolean"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "from",
          "to",
          "reason",
          "source"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "$ref": "#/definitions/url"
          }
        }
      }
    },
    "origin": {
      "enum": [
        "v1",
        "v2"
      ]
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "publisher",
        "official",
        "endObjects",
        "imds",
        "description",
        "parentOntology",
        "stabilityStatus",
        "usageStatus",
        "hasInternalWikiLink"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "official": {
          "type": "string"
        },
        "endObjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "parentOntology": {
          "type": "string"
        },
        "stabilityStatus": {
          "type": "string"
        },
        "usageStatus": {
          "type": "string"
        },
        "hasInternalWikiLink": {
          "type": "boolean"
        }
      }
    },
    "engineeringUses": {
      "description": "EDITORIAL: practical engineering uses written by atlas editors. Not a claim of adoption.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 20
      },
      "maxItems": 5
    },
    "resourceType": {
      "description": "WHAT: controlled value from data/taxonomy/resource-types.json",
      "type": "string",
      "pattern": "^[a-z-]+$"
    },
    "knowledge": {
      "description": "WHAT: one primary knowledge sub-domain (data/taxonomy/knowledge-domains.json) or not-assessed",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "basis"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "editorial",
            "source"
          ]
        },
        "sourceRef": {
          "$ref": "#/definitions/url"
        }
      }
    },
    "capabilities": {
      "description": "WHY: engineering capability ids (data/taxonomy/capabilities.json)",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "classificationBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "industries",
        "capabilities"
      ],
      "properties": {
        "industries": {
          "enum": [
            "editorial",
            "source"
          ]
        },
        "capabilities": {
          "enum": [
            "editorial",
            "source"
          ]
        }
      }
    },
    "physicalAi": {
      "description": "Proposed application categories (data/taxonomy/physical-ai.json). Empty until evidence rules are met.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "limitations": {
      "description": "Known limitations and uncertainties. Empty = none recorded (not: none exist).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "basis"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 10
          },
          "basis": {
            "enum": [
              "editorial",
              "source"
            ]
          },
          "sourceRef": {
            "$ref": "#/definitions/url"
          }
        }
      }
    },
    "editorialReview": {
      "description": "WHEN: last review of editorial fields",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedOn",
        "reviewer"
      ],
      "properties": {
        "reviewedOn": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 2,
          "not": {
            "pattern": "@"
          }
        }
      }
    },
    "details": {
      "description": "Type-specific extension keyed by resource type (e.g. dataset, standard).",
      "type": "object"
    }
  }
}
