@prefix : <https://example.org/mini#> .
@prefix ext: <https://example.org/other#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <http://schema.org/> .

<https://example.org/mini> a owl:Ontology ;
  rdfs:label "Mini test ontology" ;
  owl:versionInfo "v1.2.0" ;
  owl:imports <https://example.org/other> .

:Machine a owl:Class ; rdfs:label "Machine"@en, "Machine"@fr ; skos:definition "A device that performs work."@en ;
  rdfs:subClassOf ext:Artefact .
:Robot a owl:Class ; rdfs:label "Robot"@en ; rdfs:comment "A programmable machine."@en ;
  rdfs:subClassOf :Machine ,
    [ a owl:Restriction ; owl:onProperty :hasPart ; owl:someValuesFrom :Actuator ] ,
    [ a owl:Restriction ; owl:onProperty :serialNumber ; owl:maxCardinality "1"^^xsd:nonNegativeInteger ] .
:Actuator a owl:Class ; rdfs:label "Actuator" ; owl:disjointWith :Robot .
:Manipulator a owl:Class ; owl:equivalentClass :RobotArm ; rdfs:subClassOf :Robot .
:RobotArm a owl:Class .
:hasPart a owl:ObjectProperty ; rdfs:label "has part" ; rdfs:domain [ owl:unionOf ( :Machine :Robot ) ] ; rdfs:range :Actuator ; owl:inverseOf :partOf .
:partOf a owl:ObjectProperty .
:serialNumber a owl:DatatypeProperty ; rdfs:domain :Machine ; rdfs:range xsd:string .
:observes a owl:ObjectProperty ; schema:domainIncludes :Robot ; schema:rangeIncludes :Machine .
:r2d2 a owl:NamedIndividual , :Robot ; rdfs:label "R2-D2" .
