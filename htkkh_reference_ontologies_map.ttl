@prefix atlas: <https://opedoussaut.github.io/ht-kkh-reference-ontologies/ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Reference Ontology Atlas — generated 2026-10-15. Do not edit by hand; run `npm run build`.
# Public information only. Every fact is backed by a cited public source; verification status and date are shown on each record.

atlas:ReferenceOntology a rdfs:Class ; rdfs:label "Reference ontology" .
atlas:Industry a rdfs:Class ; rdfs:label "Industry" .
atlas:UseCase a rdfs:Class ; rdfs:label "Engineering use case" .
atlas:resourceType a rdf:Property .
atlas:knowledgeDomain a rdf:Property .
atlas:capability a rdf:Property .
atlas:licenseReviewStatus a rdf:Property .
atlas:publisher a rdf:Property .
atlas:officialSource a rdf:Property .
atlas:namespaceIri a rdf:Property .
atlas:versionLabel a rdf:Property .
atlas:licenseName a rdf:Property .
atlas:licenseAccess a rdf:Property .
atlas:maturity a rdf:Property .
atlas:layer a rdf:Property .
atlas:kind a rdf:Property .
atlas:industry a rdf:Property .
atlas:useCase a rdf:Property .
atlas:verificationStatus a rdf:Property .
atlas:topic a rdf:Property .
atlas:extends a owl:ObjectProperty ; rdfs:label "extends" ; rdfs:comment "Specialises or builds on the target's concepts." .
atlas:imports a owl:ObjectProperty ; rdfs:label "imports" ; rdfs:comment "Formally imports the target ontology." .
atlas:part_of a owl:ObjectProperty ; rdfs:label "part of" ; rdfs:comment "Published as a module of the same standard or suite." .
atlas:aligns_with a owl:ObjectProperty ; rdfs:label "aligns with" ; rdfs:comment "Provides an alignment or mapping to the target." .
atlas:superseded_by a owl:ObjectProperty ; rdfs:label "integrated into" ; rdfs:comment "Content was integrated into, or is continued by, the target." .
atlas:references a owl:ObjectProperty ; rdfs:label "references" ; rdfs:comment "Uses identifiers or terms from the target." .
atlas:follows_pattern_of a owl:ObjectProperty ; rdfs:label "follows pattern of" ; rdfs:comment "Reuses the target's design pattern." .

atlas:industry-transportation-mobility a atlas:Industry ; skos:prefLabel "Transportation & Mobility" ; dcterms:description "Automotive, rail and mobility systems, including software-defined vehicles." .
atlas:industry-aerospace-defense a atlas:Industry ; skos:prefLabel "Aerospace & Defense" ; dcterms:description "Aircraft, space systems and defence programmes driven by systems engineering and certification." .
atlas:industry-marine-offshore a atlas:Industry ; skos:prefLabel "Marine & Offshore" ; dcterms:description "Ships, offshore platforms and process installations at sea." .
atlas:industry-industrial-equipment a atlas:Industry ; skos:prefLabel "Industrial Equipment" ; dcterms:description "Machinery, automation, robotics and industrial asset lifecycles." .
atlas:industry-high-tech a atlas:Industry ; skos:prefLabel "High-Tech" ; dcterms:description "Electronics, semiconductors, computing, data centres and connected devices." .
atlas:industry-home-lifestyle a atlas:Industry ; skos:prefLabel "Home & Lifestyle" ; dcterms:description "Furniture, appliances, smart-home devices and lifestyle products." .
atlas:industry-consumer-packaged-goods-retail a atlas:Industry ; skos:prefLabel "Consumer Packaged Goods & Retail" ; dcterms:description "Packaged products, retail, e-commerce and product data exchange." .
atlas:industry-life-sciences-healthcare a atlas:Industry ; skos:prefLabel "Life Sciences & Healthcare" ; dcterms:description "Pharma, biotech, medical devices and scientific research." .
atlas:industry-infrastructure-energy-materials a atlas:Industry ; skos:prefLabel "Infrastructure, Energy & Materials" ; dcterms:description "Power generation and grids, process plants, oil & gas, chemicals and materials." .
atlas:industry-architecture-engineering-construction a atlas:Industry ; skos:prefLabel "Architecture, Engineering & Construction" ; dcterms:description "Buildings, facilities, BIM and construction projects." .
atlas:industry-business-services a atlas:Industry ; skos:prefLabel "Business Services" ; dcterms:description "Data management, cataloguing, commerce and knowledge services." .
atlas:industry-cities-public-services a atlas:Industry ; skos:prefLabel "Cities & Public Services" ; dcterms:description "Smart cities, geospatial data, public administration and regulation." .
atlas:industry-cross-industry a atlas:Industry ; skos:prefLabel "Cross-Industry" ; dcterms:description "Foundational and horizontal ontologies reusable in every industry." .
atlas:usecase-ai-factories a atlas:UseCase ; skos:prefLabel "AI Factories" ; dcterms:description "AI factories combine dense GPU compute with power distribution, liquid cooling and building systems. Getting the facility, IT equipment and energy models to share one semantic backbone makes capacity planning, energy optimisation and digital-twin operations possible." .
atlas:usecase-general-purpose-robotics a atlas:UseCase ; skos:prefLabel "General Purpose Robotics" ; dcterms:description "General-purpose robots need shared definitions of robot parts, poses, capabilities and tasks so that design, simulation, AI control and certification work from the same model. The IEEE 1872 family gives a standardised backbone on top of an upper ontology." .
atlas:usecase-semiconductors a atlas:UseCase ; skos:prefLabel "Semiconductors" ; dcterms:description "Semiconductor value chains span design, front-end fabrication, back-end assembly and test, and highly distributed supply chains. Public ontologies cover supply-chain semantics, product classification, materials and units; fab-equipment standards are still mostly non-semantic." .
atlas:usecase-sustainability a atlas:UseCase ; skos:prefLabel "Sustainability & Circularity" ; dcterms:description "Sustainability engineering needs consistent lifecycle data, traceable provenance and links to regulation. Ontologies help connect product structures with impact indicators, materials, energy and legal requirements such as digital product passports." .
atlas:usecase-personal-electronics a atlas:UseCase ; skos:prefLabel "Personal Electronics" ; dcterms:description "Smart devices combine hardware, firmware and services. Device and product-data ontologies support interoperability, commerce and compliance." .

